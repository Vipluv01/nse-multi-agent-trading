# Copy to .env (already gitignored -- never commit real values) and fill in
# whichever notification channel(s) you actually want to use. Both are
# optional; nse_agents/live/notifier.py loads this file automatically.

# Telegram: create a bot via @BotFather in Telegram, then message the bot
# once and check https://api.telegram.org/bot<token>/getUpdates for the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack or Discord incoming webhook URL (see WebhookNotifier's `platform` arg
# for which shape it sends).
NOTIFY_WEBHOOK_URL=

# Optional: hosted LLM backends (--backend anthropic / --backend openai).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
