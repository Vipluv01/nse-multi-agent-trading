.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
logs/

# Caches: regenerable, and large. Prices and headlines re-fetch from the
# network; LLM responses re-score from the local model.
data_cache/
llm_cache/
*.pt

# Result tables and figures ARE committed -- the README embeds the figures and
# the tables are the study's output. Only the bulky per-headline scores and the
# per-decision dumps are excluded.
results/sentiment/scored_*.csv
results/agents/decisions_*.csv
results/technical/oos_*.csv

# Live-pipeline output: date-specific and stale the next day, unlike the
# study's static result tables above. Regenerate with run_live_signal.py.
results/paper_trading/

# Real credentials (TELEGRAM_BOT_TOKEN, NOTIFY_WEBHOOK_URL, etc.) -- loaded by
# nse_agents/live/notifier.py's minimal .env reader. Never committed.
.env

# LaTeX build byproducts from compiling results/paper.tex -- regenerable,
# machine-specific. results/paper.pdf itself IS committed (same convention as
# the figures: a reproducible output worth having in the repo).
results/paper.aux
results/paper.log
